      "vscode_insiders": "code-insiders.exe",
      "pycharm": "pycharm64.exe",
      "intellij": "idea64.exe",
      "webstorm": "webstorm64.exe",
      "android_studio": "studio64.exe",
      "postgre_sql": "pgAdmin4.exe",
      "mysql_workbench": "MySQLWorkbench.exe",
      "filezilla": "filezilla.exe",
      "putty": "putty.exe",
      "winscp": "WinSCP.exe",
      "virtual_studio": "devenv.exe",
      "powershell_ise": "powershell_ise.exe",
      "command_prompt": "cmd.exe",
      "powershell_core": "pwsh.exe"
    },
    "web_applications": {
      "google": "https://www.google.com/",
      "youtube": "https://www.youtube.com/",
      "gmail": "https://mail.google.com/",
      "google_drive": "https://drive.google.com/",
      "google_calendar": "https://calendar.google.com/",
      "github": "https://github.com/",
      "chatgpt": "https://chatgpt.com/",
      "spotify": "https://open.spotify.com/",
      "instagram": "https://www.instagram.com/",
      "twitter": "https://twitter.com/",
      "linkedin": "https://www.linkedin.com/",
      "netfix": "https://www.netflix.com/",
      "reddit": "https://www.reddit.com/",
      "stackoverflow": "https://stackoverflow.com/",
      "medium": "https://medium.com/",
      "quora": "https://www.quora.com/",
      "wikipedia": "https://www.wikipedia.org/",
      "yahoo": "https://www.yahoo.com/",
      "bing": "https://www.bing.com/",
      "duckduckgo": "https://duckduckgo.com/",
      "amazon": "https://www.amazon.com/",
      "ebay": "https://www.ebay.com/",
      "walmart": "https://www.walmart.com/",
      "target": "https://www.target.com/",
      "bestbuy": "https://www.bestbuy.com/",
      "aliexpress": "https://www.aliexpress.com/",
      "etsy": "https://www.etsy.com/",
      "paypal": "https://www.paypal.com/",
      "stripe": "https://stripe.com/",
      "square": "https://squareup.com/",
      "shopify": "https://www.shopify.com/",
      "wordpress": "https://wordpress.com/",
      "wix": "https://www.wix.com/",
      "weebly": "https://www.weebly.com/",
      "squarespace": "https://www.squarespace.com/",
      "joomla": "https://www.joomla.org/",
      "drupal": "https://www.drupal.org/",
      "magento": "https://magento.com/",
      "opencart": "https://www.opencart.com/",
      "prestashop": "https://www.prestashop.com/",
      "bigcommerce": "https://www.bigcommerce.com/",
      "daraz": "https://www.daraz.com/",
      "flipkart": "https://www.flipkart.com/",
      "snapdeal": "https://www.snapdeal.com/",
      "myntra": "https://www.myntra.com/",
      "ajio": "https://www.ajio.com/",
      "lazada": "https://www.lazada.com/",
      "shopee": "https://shopee.com/",
      "tokopedia": "https://www.tokopedia.com/",
      "bukalapak": "https://www.bukalapak.com/",
      "nike": "https://www.nike.com/",
      "adidas": "https://www.adidas.com/",
      "puma": "https://us.puma.com/",
      "reebok": "https://www.reebok.com/",
      "under_armour": "https://www.underarmour.com/",
      "new_balance": "https://www.newbalance.com/",
      "asics": "https://www.asics.com/",
      "saucony": "https://www.saucony.com/",
      "brooks": "https://www.brooksrunning.com/",
      "hoka": "https://www.hoka.com/",
      "salomon": "https://www.salomon.com/",
      "merrell": "https://www.merrell.com/",
      "columbia": "https://www.columbia.com/",
      "the_north_face": "https://www.thenorthface.com/",
      "patagonia": "https://www.patagonia.com/",
      "marmot": "https://www.marmot.com/"

    },
    "allowed_commands": [
      "whoami.exe",
      "hostname.exe",
      "where.exe"
    ]
  },
  "voice": {
    "enabled": true,
    "stt_provider": "groq",
    "stt_model": "whisper-large-v3-turbo",
    "language": "en",
    "sample_rate": 16000,
    "max_recording_seconds": 20,
    "minimum_recording_seconds": 0.4,
    "tts_enabled": true,
    "tts_rate": 175,
    "tts_volume": 1.0,
    "preferred_voice_keywords": [
      "david",
      "mark",
      "male"
    ]
  },
  "wake": {
    "enabled": true,
    "backend": "vosk",
    "phrase": "argus",
    "recognition_aliases": [
      "argus",
      "august",
      "argos"
    ],
    "model_path": "../models/vosk-model-small-en-us-0.15",
    "sample_rate": 16000,
    "command_max_seconds": 15,
    "silence_seconds": 1.5,
    "speech_threshold": 350,
    "command_attempts": 2,
    "acknowledgement": "Yes, sir?"
  },
  "memory": {
    "enabled": true,
    "database_path": "%LOCALAPPDATA%/Argus/argus.db",
    "profile_id": "owner",
    "profile_name": "Owner",
    "conversation_context_messages": 20
  },
  "vision": {
    "enabled": true,
    "allowed_image_roots": [
      ".."
    ],
    "camera_index": 0,
    "capture_width": 1280,
    "capture_height": 720,
    "warmup_frames": 5,
    "object_model_path": "../models/vision/efficientdet_lite0.tflite",
    "gesture_model_path": "../models/vision/gesture_recognizer.task",
    "face_model_path": "../models/vision/blaze_face_short_range.tflite",
    "object_score_threshold": 0.45,
    "gesture_score_threshold": 0.6,
    "max_results": 10,
    "detect_faces": true
  },
  "robotics": {
    "enabled": true,
    "devices": [
      {
        "id": "sim_robot",
        "name": "Argus Simulated Robot",
        "transport": "simulator",
        "baud_rate": 115200,
        "timeout_seconds": 2.0,
        "startup_delay_seconds": 2.0,
        "actuators_enabled": true,
        "allowed_actuators": [
          "led",
          "servo",
          "motor_left",
          "motor_right"
        ],
        "telemetry": {
          "distance_cm": "cm",
          "temperature_c": "C",
          "humidity_percent": "%",
          "battery_percent": "%",
          "obstacle_detected": ""
        },
        "simulated_telemetry": {
          "distance_cm": 240.0,
          "temperature_c": 23.5,
          "humidity_percent": 45,
          "battery_percent": 87,
          "obstacle_detected": false
        }
      }
    ]
  },
  "proactive": {
    "enabled": false,
    "poll_interval_seconds": 30,
    "quiet_hours_start": "22:00",
    "quiet_hours_end": "07:00",
    "minimum_priority": "normal",
    "enabled_categories": [
      "reminders",
      "deadlines",
      "calendar",
      "system"
    ],
    "calendar_lead_minutes": 15,
    "max_notifications_per_cycle": 5,
    "battery_warning_percent": 15,
    "disk_free_warning_percent": 10
  },
  "dashboard": {
    "enabled": true,
    "refresh_interval_seconds": 30,
    "window_width": 1100,
    "window_height": 720,
    "notification_limit": 50,
    "idle_timeout_seconds": 120,
    "wake_phrase": "wake up argus i am back"
  }
}
