{
  "assistant": {
    "name": "Argus",
    "purpose": "Help with learning, coding, robotics, research, problem-solving, project planning, and personal organization."
  },
  "ai": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "temperature": 0.3,
    "max_completion_tokens": 1024
  },
  "tools": {
    "enabled": true,
    "max_rounds": 6,
    "allowed_roots": [
      ".."
